#!/usr/bin/env bash
# Launcher for KOMPRESS-OR.CLI - always uses the project virtual environment.
# Usage: ./kompressor            (interactive menu)
#        ./kompressor --check    (encoder availability)
#        ./kompressor --version
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$DIR/.venv/bin/python" ]; then
    echo "Error: virtual environment not found at $DIR/.venv" >&2
    echo "Create it with:" >&2
    echo "  python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'" >&2
    exit 1
fi
cd "$DIR"
exec "$DIR/.venv/bin/python" -m kompressor "$@"
